{
  "functions": [{ "source": "backend/kriah-staging", "codebase": "kriah-staging" }],
  "hosting": {
    "site": "fun-torah-tools-staging",
    "public": ".kriah-preview",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [{ "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }],
    "redirects": [{ "source": "/", "destination": "/kriah-assessment/index.html", "type": 302 }, { "source": "/index.html", "destination": "/kriah-assessment/index.html", "type": 302 }]
  }
}
