{
  "hosting": {
    "site": "fun-torah-tools-staging",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.*.json",
      ".firebaserc",
      "**/node_modules/**",
      "**/tests/**",
      "**/e2e/**",
      "**/e2e-staging/**",
      "**/scripts/**",
      "**/docs/**",
      "**/staging/test-credentials.local.json",
      "**/staging/*.local.*",
      "preview-pointer-repair/**",
      "preview-pr234/**",
      "**/backup-*/**",
      "**/_worktrees/**",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/staging-results/**",
      "**/.env*",
      "**/*.local.*",
      "package.json",
      "package-lock.json",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "/__fn/funTorahStudentAuth",
        "function": {
          "functionId": "funTorahStudentAuth",
          "region": "us-central1"
        }
      },
      {
        "source": "/__fn/funTorahManageStudents",
        "function": {
          "functionId": "funTorahManageStudents",
          "region": "us-central1"
        }
      },
      {
        "source": "/__fn/funTorahTeacherClaim",
        "function": {
          "functionId": "funTorahTeacherClaim",
          "region": "us-central1"
        }
      },
      {
        "source": "/__fn/studentRewardsAutoAward",
        "function": {
          "functionId": "studentRewardsAutoAward",
          "region": "us-central1"
        }
      },
      {
        "source": "/__fn/weeklyQuizStudent",
        "function": {
          "functionId": "weeklyQuizStudent",
          "region": "us-central1"
        }
      },
      {
        "source": "/__fn/studentRewardsLogin",
        "function": {
          "functionId": "studentRewardsLogin",
          "region": "us-central1"
        }
      },
      {
        "source": "/__fn/yiddishApi",
        "function": {
          "functionId": "yiddishApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/__fn/homeworkPortal",
        "function": {
          "functionId": "homeworkPortal",
          "region": "us-central1"
        }
      },
      {
        "source": "/__fn/classPointerShareAuth",
        "function": {
          "functionId": "classPointerShareAuth",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}