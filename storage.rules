rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // A teacher owns their own PDF files. No public reads or student library access.
    match /pointerPdfLibrary/{teacherUid}/{fileId} {
      allow read, delete: if request.auth != null && request.auth.uid == teacherUid;
      allow create: if request.auth != null && request.auth.uid == teacherUid
        && fileId.matches('[a-zA-Z0-9-]+\\.pdf')
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update: if request.auth != null && request.auth.uid == teacherUid
        && resource.size == request.resource.size
        && resource.md5Hash == request.resource.md5Hash
        && request.resource.contentType == 'application/pdf';
    }
  }
}
