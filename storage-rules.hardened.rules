rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedStudent(studentId) {
      return request.auth != null
        && request.auth.token.b3StudentRole == 'student'
        && request.auth.token.b3StudentId == studentId
        && request.auth.token.b3ClassId is string;
    }
    function imageOrAudio() {
      return request.resource == null
        || request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*|video/.*');
    }
    match /posukPractice/{studentId}/{file=**} {
      allow read: if signedStudent(studentId);
      allow create, update: if signedStudent(studentId) && imageOrAudio();
      allow delete: if signedStudent(studentId);
    }
    match /shorashimLearning/students/{studentId}/drawings/{file=**} {
      allow read: if signedStudent(studentId);
      allow create, update: if signedStudent(studentId) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedStudent(studentId);
    }
    // Only verified site owner can create teacher screenshots; never grants
    // arbitrary student uploads or permission to modify existing pictures.
    match /shorashim-teacher-pictures/{ownerUid}/{file=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == ownerUid
        && request.auth.token.email == 'simcha5770@gmail.com'
        && request.auth.token.email_verified == true
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|webp)');
      allow update, delete: if false;
    }
    match /shorashim-recordings/{studentId}/{file=**} {
      allow read: if signedStudent(studentId);
      allow create, update: if signedStudent(studentId) && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if signedStudent(studentId);
    }
    match /classGallery/{classId}/{studentId}/{postId}/{file=**} {
      allow read: if signedStudent(studentId) && request.auth.token.b3ClassId == classId;
      allow create, update: if signedStudent(studentId) && request.auth.token.b3ClassId == classId
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*|video/.*');
      allow delete: if signedStudent(studentId) && request.auth.token.b3ClassId == classId;
    }
    // Class Pointer student files are private to the matching student and class.
    match /studentFiles/{classId}/{studentId}/{fileId} {
      function ownsStudentPath() {
        return request.auth != null
          && 'b3StudentRole' in request.auth.token
          && request.auth.token.b3StudentRole == 'student'
          && request.auth.token.b3StudentId == studentId
          && request.auth.token.b3ClassId == classId;
      }
      allow get, list, delete: if ownsStudentPath();
      allow create, update: if ownsStudentPath() && (
        (fileId.matches('[-A-Za-z0-9_]{1,64}[.]json')
          && request.resource.contentType == 'application/json'
          && request.resource.size <= 3 * 1024 * 1024)
        || (fileId.matches('[-A-Za-z0-9_]{1,64}[.]png')
          && request.resource.contentType == 'image/png'
          && request.resource.size <= 2 * 1024 * 1024)
        || (fileId.matches('[-A-Za-z0-9_]{1,64}[.]pdf')
          && request.resource.contentType == 'application/pdf'
          && request.resource.size <= 25 * 1024 * 1024)
      );
    }
    // Teacher lesson whiteboards follow the owner-only shape of pointerPdfLibrary.
    match /pointerWhiteboards/{teacherUid}/{fileId} {
      function ownsTeacherPath() {
        return request.auth != null
          && request.auth.uid == teacherUid
          && !('b3StudentRole' in request.auth.token);
      }
      allow get, list, delete: if ownsTeacherPath();
      allow create, update: if ownsTeacherPath() && (
        (fileId.matches('[-A-Za-z0-9_]{1,64}[.]json')
          && request.resource.contentType == 'application/json'
          && request.resource.size <= 10 * 1024 * 1024)
        || (fileId.matches('[-A-Za-z0-9_]{1,64}[.]png')
          && request.resource.contentType == 'image/png'
          && request.resource.size <= 2 * 1024 * 1024)
      );
    }
    match /{file=**} { allow read, write: if false; }
  }
}
