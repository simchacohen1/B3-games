rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Existing rules, preserved exactly so current activities continue to work.
    // SECURITY DEBT: these three locations are currently PUBLIC read and write.
    match /posukPractice/{studentId}/{fileName} {
      allow read, write: if true;
    }

    match /classGallery/{postId}/{fileName} {
      allow read, write: if true;
    }

    match /shorashim-recordings/{studentId}/{date}/{fileName} {
      allow read, write: if true;
    }

    // NEW: each authenticated teacher owns a private PDF folder by Firebase UID.
    // No other user's UID, nor an anonymous visitor, can list/get/change it.
    match /pointerPdfLibrary/{teacherUid}/{fileId} {
      allow get, list, delete: if request.auth != null
        && request.auth.uid == teacherUid;

      allow create: if request.auth != null
        && request.auth.uid == teacherUid
        && fileId.matches('[-a-zA-Z0-9]+[.]pdf')
        && request.resource.size <= 500 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';

      // Rename/remember-page updates only: file bytes cannot be replaced.
      allow update: if request.auth != null
        && request.auth.uid == teacherUid
        && resource.size == request.resource.size
        && resource.md5Hash == request.resource.md5Hash
        && request.resource.contentType == 'application/pdf';
    }

    // Class Pointer student files are private to the matching student and class.
    match /studentFiles/{classId}/{studentId}/{fileId} {
      function ownsStudentPath() {
        return request.auth != null
          && 'b3StudentRole' in request.auth.token
          && request.auth.token.b3StudentRole == 'student'
          && request.auth.token.b3StudentId == studentId
          && request.auth.token.b3ClassId == classId;
      }
      allow get, list, delete: if ownsStudentPath();
      allow create, update: if ownsStudentPath() && (
        (fileId.matches('[-A-Za-z0-9_]{1,64}[.]json')
          && request.resource.contentType == 'application/json'
          && request.resource.size <= 3 * 1024 * 1024)
        || (fileId.matches('[-A-Za-z0-9_]{1,64}[.]png')
          && request.resource.contentType == 'image/png'
          && request.resource.size <= 2 * 1024 * 1024)
        || (fileId.matches('[-A-Za-z0-9_]{1,64}[.]pdf')
          && request.resource.contentType == 'application/pdf'
          && request.resource.size <= 25 * 1024 * 1024)
      );
    }

    // Teacher lesson whiteboards follow the owner-only shape of pointerPdfLibrary.
    match /pointerWhiteboards/{teacherUid}/{fileId} {
      function ownsTeacherPath() {
        return request.auth != null
          && request.auth.uid == teacherUid
          && !('b3StudentRole' in request.auth.token);
      }
      allow get, list, delete: if ownsTeacherPath();
      allow create, update: if ownsTeacherPath() && (
        (fileId.matches('[-A-Za-z0-9_]{1,64}[.]json')
          && request.resource.contentType == 'application/json'
          && request.resource.size <= 10 * 1024 * 1024)
        || (fileId.matches('[-A-Za-z0-9_]{1,64}[.]png')
          && request.resource.contentType == 'image/png'
          && request.resource.size <= 2 * 1024 * 1024)
      );
    }
  }
}
